{
  "name": "ai-agent-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "volta": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:world": "python scripts/python_env.py -m uvicorn world.api:app --app-dir apps --host 127.0.0.1 --port 8000 --reload --reload-dir apps/world",
    "status:dev": "python scripts/python_env.py -m uvicorn ops_status.api:app --app-dir apps --host 127.0.0.1 --port 8010",
    "test": "vitest run --config apps/web/vitest.config.ts && node --test scripts/tests/status_dashboard.test.mjs && python scripts/python_env.py -m pytest",
    "lint": "eslint . && python scripts/python_env.py -m ruff check .",
    "format": "prettier --write . && python scripts/python_env.py -m ruff format .",
    "format:check": "prettier --check . && python scripts/python_env.py -m ruff format --check .",
    "build": "tsc --project apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "api:generate": "python scripts/python_env.py scripts/export_openapi.py && openapi-typescript docs/api/openapi.json -o apps/web/src/api/schema.d.ts && prettier --write docs/api/openapi.json apps/web/src/api/schema.d.ts",
    "api:check": "node scripts/check_api.mjs",
    "factory:check": "python scripts/python_env.py scripts/factory.py",
    "test:factory": "python scripts/python_env.py -m pytest scripts/tests",
    "docs:check": "python scripts/check_tools.py docs",
    "iac:check": "python scripts/check_tools.py iac",
    "check": "npm run api:check && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
