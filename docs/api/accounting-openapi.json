{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounting Cash Application Agent",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounting/runs": {
      "get": {
        "summary": "Runs",
        "operationId": "runs_api_accounting_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Runs Api Accounting Runs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start",
        "operationId": "start_api_accounting_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounting/runs/{run_id}/advance": {
      "post": {
        "summary": "Advance",
        "operationId": "advance_api_accounting_runs__run_id__advance_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounting/runs/{run_id}/answer": {
      "post": {
        "summary": "Answer",
        "operationId": "answer_api_accounting_runs__run_id__answer_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounting/runs/{run_id}": {
      "get": {
        "summary": "Run",
        "operationId": "run_api_accounting_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdvanceRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "expected_step_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Step Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "expected_step_version"],
        "title": "AdvanceRequest"
      },
      "AnswerRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "expected_step_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Step Version"
          },
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "expected_step_version", "question_id", "answer"],
        "title": "AnswerRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Question": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 2,
            "title": "Options"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["question_id", "question", "reason", "options"],
        "title": "Question"
      },
      "RunView": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "fixture_id": {
            "type": "string",
            "title": "Fixture Id"
          },
          "model_attempts": {
            "type": "integer",
            "title": "Model Attempts"
          },
          "model_successes": {
            "type": "integer",
            "title": "Model Successes"
          },
          "model_failures": {
            "type": "integer",
            "title": "Model Failures"
          },
          "step_version": {
            "type": "integer",
            "title": "Step Version"
          },
          "tool_calls": {
            "type": "integer",
            "title": "Tool Calls"
          },
          "question_count": {
            "type": "integer",
            "title": "Question Count"
          },
          "proposal_count": {
            "type": "integer",
            "title": "Proposal Count"
          },
          "deadline_at": {
            "type": "string",
            "title": "Deadline At"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "trace": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Trace"
          },
          "artifact": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact"
          },
          "pending_question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Question"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "mode",
          "status",
          "fixture_id",
          "model_attempts",
          "model_successes",
          "model_failures",
          "step_version",
          "tool_calls",
          "question_count",
          "proposal_count",
          "deadline_at",
          "created_at",
          "trace",
          "artifact"
        ],
        "title": "RunView"
      },
      "StartRunRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["agent", "baseline"],
            "title": "Mode",
            "default": "agent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "StartRunRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
