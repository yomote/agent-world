  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid",
            "title": "Action Id"
          },
          "actor_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Actor Id"
          },
          "type": {
            "type": "string",
            "const": "move",
            "title": "Type"
          },
          "dx": {
            "type": "integer",
            "title": "Dx"
          },
          "dy": {
            "type": "integer",
            "title": "Dy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "actor_id", "type", "dx", "dy"],
        "title": "Action"
      },
      "ActionResult": {
        "properties": {
          "world": {
            "$ref": "#/components/schemas/WorldState"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 80,
            "title": "Events"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["world", "events", "event"],
        "title": "ActionResult"
      },
      "ApplyRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid",
            "title": "Action Id"
          },
          "proposal_hash": {
            "type": "string",
            "title": "Proposal Hash"
          },
          "expected_revision": {
            "type": "integer",
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "proposal_hash", "expected_revision"],
        "title": "ApplyRequest"
      },
      "ApprovalRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid",
            "title": "Action Id"
          },
          "proposal_hash": {
            "type": "string",
            "title": "Proposal Hash"
          },
          "expected_revision": {
            "type": "integer",
            "title": "Expected Revision"
          },
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "proposal_hash", "expected_revision", "approve"],
        "title": "ApprovalRequest"
      },
      "Entity": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "position"],
        "title": "Entity"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failure"],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "enum": ["moved", "out_of_bounds", "unknown_actor", "invalid_move"],
            "title": "Reason"
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "world_id": {
            "type": "string",
            "format": "uuid",
            "title": "World Id"
          },
          "world_revision": {
            "type": "integer",
            "title": "World Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "action",
          "status",
          "reason",
          "before",
          "after",
          "world_id",
          "world_revision"
        ],
        "title": "Event"
      },
      "EventHistory": {
        "properties": {
          "world": {
            "$ref": "#/components/schemas/WorldState"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 80,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["world", "events"],
        "title": "EventHistory"
      },
      "EvidenceItem": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["ref", "source", "timestamp", "data"],
        "title": "EvidenceItem"
      },
      "ExecutionRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid",
            "title": "Action Id"
          },
          "proposal": {
            "$ref": "#/components/schemas/RecoveryProposal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action_id", "proposal"],
        "title": "ExecutionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentRunRequest": {
        "properties": {
          "scenario_number": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Scenario Number"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["scenario_number"],
        "title": "IncidentRunRequest"
      },
      "IncidentSnapshot": {
        "properties": {
          "scenario_number": {
            "type": "integer",
            "title": "Scenario Number"
          },
          "summary": {
            "$ref": "#/components/schemas/IncidentSummary"
          },
          "services": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Services"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "pending_proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecoveryProposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposal_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Hash"
          },
          "approved_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved Hash"
          },
          "applied_changes": {
            "items": {
              "$ref": "#/components/schemas/RecoveryChange"
            },
            "type": "array",
            "title": "Applied Changes",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["scenario_number", "summary", "services", "evidence"],
        "title": "IncidentSnapshot"
      },
      "IncidentSummary": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "incomplete": {
            "type": "integer",
            "title": "Incomplete"
          },
          "completed": {
            "type": "integer",
            "title": "Completed"
          },
          "duplicate_count": {
            "type": "integer",
            "title": "Duplicate Count"
          },
          "state": {
            "type": "string",
            "enum": [
              "investigating",
              "waiting_approval",
              "applying",
              "verifying",
              "recovered",
              "stopped"
            ],
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "revision",
          "accepted",
          "incomplete",
          "completed",
          "duplicate_count",
          "state"
        ],
        "title": "IncidentSummary"
      },
      "IncidentToolRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "observe_system",
              "query_events",
              "inspect_queue",
              "read_service_config",
              "list_changes",
              "search_knowledge",
              "probe_dependency",
              "advance_and_verify",
              "lookup_action_status"
            ],
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["tool"],
        "title": "IncidentToolRequest"
      },
      "IncidentToolResult": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failure", "denied"],
            "title": "Status"
          },
          "summary": {
            "$ref": "#/components/schemas/IncidentSummary"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Evidence"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["tool", "status", "summary", "evidence"],
        "title": "IncidentToolResult"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "integer",
            "title": "X"
          },
          "y": {
            "type": "integer",
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["x", "y"],
        "title": "Position"
      },
      "ProposalResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "waiting_approval",
              "approved",
              "applied",
              "failure",
              "stale"
            ],
            "title": "Status"
          },
          "proposal_hash": {
            "type": "string",
            "title": "Proposal Hash"
          },
          "summary": {
            "$ref": "#/components/schemas/IncidentSummary"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations",
            "default": []
          },
          "event_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Event Refs",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["status", "proposal_hash", "summary"],
        "title": "ProposalResult"
      },
      "RecoveryChange": {
        "properties": {
