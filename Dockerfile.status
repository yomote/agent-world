FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-status.txt ./
RUN pip install --no-cache-dir --requirement requirements-status.txt

COPY apps/ops_status ./apps/ops_status
COPY docs/status ./docs/status

USER 65532:65532
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "ops_status.api:app", "--app-dir", "apps", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
